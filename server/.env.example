# Copier ce fichier en server/.env et remplir les valeurs.

# Chaîne de connexion MongoDB Atlas de l'utilisateur APPLICATIF (droits readWrite sur la base uniquement).
# Le nom de la base (express-food) doit figurer dans l'URL.
DATABASE_URL="mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/express-food?retryWrites=true&w=majority"
# En local avec docker compose :
# DATABASE_URL="mongodb://localhost:27017/express-food?replicaSet=rs0&directConnection=true"

# Secret de signature des sessions : au moins 32 caractères aléatoires.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-remplacer-par-une-longue-chaine-aleatoire-de-48-octets"

PORT=4000

# Position du QG (cuisine) d'où partent les livreurs.
QG_LAT=48.8566
QG_LNG=2.3522

# Règles de livraison (en centimes)
DELIVERY_FEE_CENTS=250
FREE_DELIVERY_THRESHOLD_CENTS=1999
# Temps de trajet moyen QG -> client à vélo (minutes)
DELIVERY_RIDE_MINUTES=10
